# Test-only database credentials. Copy to .env.test (gitignored) when a test command needs them.
# Loaded only by `test:integration` and the e2e account tooling, never by dev, infra, db:migrate,
# user:create, or any app. Read through loadFixtureEnv / loadBootstrapEnv in packages/config, which
# refuse NODE_ENV=production and never fall back to DATABASE_URL. The values match the
# development-only placeholders in .env.example for the local Docker Compose stack (127.0.0.1);
# never reuse them anywhere else.

# contextvault_fixture: NOSUPERUSER BYPASSRLS, DML only. Seeds and cleanup.
DATABASE_FIXTURE_URL=postgres://contextvault_fixture:dev-only-fixture-password@127.0.0.1:5432/contextvault
# Bootstrap superuser (POSTGRES_USER). Catalog probes only.
DATABASE_BOOTSTRAP_URL=postgres://contextvault:dev-only-postgres-password@127.0.0.1:5432/contextvault
