# Test-only database credentials. Copy to .env.test (gitignored) when a test command needs them.
# Loaded only by `test:integration` and the e2e account tooling, never by dev, infra, db:migrate,
# user:create, or any app. Read through loadFixtureEnv / loadBootstrapEnv in packages/config, which
# refuse NODE_ENV=production and never fall back to DATABASE_URL. Placeholders only: use values for
# the local Docker Compose stack and never reuse them anywhere else.

# Dedicated fixture role for seeds and cleanup.
DATABASE_FIXTURE_URL=postgres://fixture-user:replace-me@127.0.0.1:5432/contextvault
# Bootstrap superuser for catalog probes only.
DATABASE_BOOTSTRAP_URL=postgres://bootstrap-user:replace-me@127.0.0.1:5432/contextvault

# TRANSITIONAL (removed in A2d-3): until the fixture role exists, point both variables at the
# DATABASE_MIGRATION_URL value from .env, e.g.
#   url=$(grep '^DATABASE_MIGRATION_URL=' .env | cut -d= -f2-)
#   printf 'DATABASE_FIXTURE_URL=%s\nDATABASE_BOOTSTRAP_URL=%s\n' "$url" "$url" > .env.test
# CI does the same in its "Test-tool credentials" step. A2d-3 deletes that step and this block.
