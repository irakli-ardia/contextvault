{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["scripts/**/*.mjs"],
  "rules": {
    "unused-dev-dependencies": "error",
    "type-only-dependencies": "error"
  },
  "boundaries": {
    "zones": [
      { "name": "web", "patterns": ["apps/web/**"] },
      { "name": "api-http", "patterns": ["apps/api/src/http/**"] },
      { "name": "api-testing", "patterns": ["apps/api/src/testing/**"] },
      { "name": "api-auth", "patterns": ["apps/api/src/auth/**"] },
      { "name": "api-documents", "patterns": ["apps/api/src/documents/**"] },
      { "name": "api-storage", "patterns": ["apps/api/src/storage/**"] },
      { "name": "api-health", "patterns": ["apps/api/src/health/**"] },
      { "name": "api-workspaces", "patterns": ["apps/api/src/workspaces/**"] },
      {
        "name": "api",
        "patterns": ["apps/api/*", "apps/api/src/*", "apps/api/src/integration/**"]
      },
      { "name": "worker-queue", "patterns": ["apps/worker/src/queue/**"] },
      { "name": "worker-ingestion", "patterns": ["apps/worker/src/ingestion/**"] },
      { "name": "worker-recovery", "patterns": ["apps/worker/src/recovery/**"] },
      { "name": "worker-purge", "patterns": ["apps/worker/src/purge/**"] },
      {
        "name": "worker",
        "patterns": ["apps/worker/*", "apps/worker/src/*", "apps/worker/src/testing/**"]
      },
      { "name": "auth", "patterns": ["packages/auth/**"] },
      { "name": "config", "patterns": ["packages/config/**"] },
      { "name": "contracts", "patterns": ["packages/contracts/**"] },
      { "name": "domain", "patterns": ["packages/domain/**"] },
      { "name": "db", "patterns": ["packages/db/**"] },
      { "name": "storage", "patterns": ["packages/storage/**"] },
      { "name": "ingestion", "patterns": ["packages/ingestion/**"] },
      { "name": "retrieval", "patterns": ["packages/retrieval/**"] },
      { "name": "ai", "patterns": ["packages/ai/**"] }
    ],
    "rules": [
      { "from": "web", "allow": ["config", "contracts"] },
      {
        "from": "api",
        "allow": [
          "api-http",
          "api-testing",
          "api-auth",
          "api-documents",
          "api-storage",
          "api-health",
          "api-workspaces",
          "auth",
          "config",
          "contracts",
          "db",
          "domain",
          "storage",
          "retrieval",
          "ai"
        ]
      },
      {
        "from": "api-testing",
        "allow": ["api", "api-storage", "auth", "config", "db", "domain", "storage"]
      },
      {
        "from": "api-auth",
        "allow": ["api-http", "api-testing", "auth", "config", "db", "domain"]
      },
      {
        "from": "api-documents",
        "allow": [
          "api-http",
          "api-testing",
          "api-auth",
          "api-storage",
          "config",
          "contracts",
          "db",
          "domain",
          "ai"
        ]
      },
      { "from": "api-storage", "allow": ["config", "contracts", "domain", "storage"] },
      { "from": "api-health", "allow": ["api-auth", "api-testing"] },
      { "from": "api-workspaces", "allow": ["api-auth", "db", "domain"] },
      {
        "from": "worker",
        "allow": [
          "worker-queue",
          "worker-ingestion",
          "worker-recovery",
          "worker-purge",
          "config",
          "db",
          "domain",
          "ingestion",
          "storage",
          "ai"
        ]
      },
      {
        "from": "worker-queue",
        "allow": ["worker", "config", "db", "domain", "ingestion", "ai"]
      },
      {
        "from": "worker-ingestion",
        "allow": ["worker", "worker-queue", "config", "db", "domain", "ingestion", "storage", "ai"]
      },
      { "from": "worker-recovery", "allow": ["worker", "worker-queue", "config", "db", "domain"] },
      { "from": "worker-purge", "allow": ["worker", "domain"] },
      { "from": "api-http", "allow": ["domain"] },

      { "from": "auth", "allow": ["domain"] },
      { "from": "config", "allow": [] },
      { "from": "contracts", "allow": [] },
      { "from": "domain", "allow": [] },
      { "from": "db", "allow": ["auth", "config", "domain"] },
      { "from": "storage", "allow": ["config", "domain"] },

      { "from": "ingestion", "allow": ["domain"] },
      { "from": "retrieval", "allow": ["domain"] },
      { "from": "ai", "allow": ["domain"] }
    ],
    "coverage": { "requireAllFiles": true, "allowUnmatched": ["scripts/**", "**/*.config.ts"] }
  }
}
