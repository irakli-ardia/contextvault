# Every variable the project reads. Copy to .env and fill in values; never commit .env.
# Values below are DEVELOPMENT-ONLY placeholders for the local Docker Compose stack
# (infra/compose.yaml, bound to 127.0.0.1). Never reuse them anywhere else.

NODE_ENV=development
API_PORT=3001

# Local infrastructure (Docker Compose)
POSTGRES_USER=contextvault
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=contextvault
DATABASE_URL=postgres://contextvault:dev-only-postgres-password@127.0.0.1:5432/contextvault
REDIS_PASSWORD=dev-only-redis-password
REDIS_URL=redis://:dev-only-redis-password@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=contextvault-dev
S3_ACCESS_KEY_ID=dev-only-access-key
S3_SECRET_ACCESS_KEY=dev-only-secret-key-0123456789
