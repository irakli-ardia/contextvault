# Every variable the project reads. Copy to .env and fill in values; never commit .env.
# Values below are DEVELOPMENT-ONLY placeholders for the local Docker Compose stack
# (infra/compose.yaml, bound to 127.0.0.1). Never reuse them anywhere else.

# Read through packages/config, the only module that touches process.env.
#
# Launcher (scripts/run-with-env.mjs): each app receives only its allowlisted names.
# - api and worker: each name comes from the parent environment, else from this file.
# - web: never reads this file, so API_INTERNAL_URL must come from the parent environment.
# - Everything else here (POSTGRES_*, REDIS_PASSWORD, DATABASE_MIGRATION_URL) is not forwarded.
#
# Required at startup (a missing or malformed value stops the app, naming the variable, never its value):
# - api: NODE_ENV, API_PORT, API_HOST, WEB_ORIGIN, DATABASE_URL, S3_* (bare origin, https in
#   production), and TRUSTED_PROXY_HOPS in production.
# - worker: NODE_ENV, REDIS_URL.
# - DATABASE_MIGRATION_URL is validated by packages/config but required by no app.
#
# Web reads only the optional API_INTERNAL_URL: the /api/* rewrite takes it at build time, the upload
# route handler at run time; set the same value for both (docs/local-setup.md).
# Test-only credentials (DATABASE_FIXTURE_URL, DATABASE_BOOTSTRAP_URL) never belong here: see .env.test.example.

NODE_ENV=development
API_PORT=3001
# Explicit bind address; never all interfaces by default.
API_HOST=127.0.0.1
# The only origin allowed to make unsafe requests (bare origin; https in production).
WEB_ORIGIN=http://127.0.0.1:3000
# Proxies between the internet and the API that append the client address (Express trust proxy).
# 0 when the API is reached directly; mandatory in production, where a wrong count makes the
# client address spoofable.
TRUSTED_PROXY_HOPS=0
# Bare origin of the API (this is the default). The /api/* rewrite bakes it into `next build`; the upload route handler reads it when the server starts. Use the same value for both.
# API_INTERNAL_URL=http://127.0.0.1:3001

# Local infrastructure (Docker Compose).
# POSTGRES_* and REDIS_PASSWORD are read by Compose (and `infra:roles`) only; keep them consistent
# with the URLs. POSTGRES_USER is the bootstrap superuser: it initialises the database and nothing
# else here uses it. contextvault_owner (DATABASE_MIGRATION_URL) owns the schema and is used only
# by `pnpm run db:migrate` and `user:create`; it is not a superuser and does not bypass row-level
# security. Apps connect as contextvault_app (DATABASE_URL), which cannot own tables, bypass
# row-level security, or run DDL. contextvault_fixture (test tooling) is in .env.test.example.
# Roles are created when the data volume is first initialised. A volume created before the owner
# and fixture roles existed keeps the old roles until `pnpm run infra:roles` (docs/local-setup.md).
POSTGRES_USER=contextvault
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_APP_PASSWORD=dev-only-app-password
POSTGRES_OWNER_PASSWORD=dev-only-owner-password
POSTGRES_FIXTURE_PASSWORD=dev-only-fixture-password
POSTGRES_DB=contextvault
DATABASE_URL=postgres://contextvault_app:dev-only-app-password@127.0.0.1:5432/contextvault
DATABASE_MIGRATION_URL=postgres://contextvault_owner:dev-only-owner-password@127.0.0.1:5432/contextvault
REDIS_PASSWORD=dev-only-redis-password
REDIS_URL=redis://:dev-only-redis-password@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
# S3_REGION is optional (defaults to us-east-1); every other variable below is required.
S3_REGION=us-east-1
S3_BUCKET=contextvault-dev
S3_ACCESS_KEY_ID=dev-only-access-key
S3_SECRET_ACCESS_KEY=dev-only-secret-key-0123456789
