# Every variable the project reads. Copy to .env and fill in values; never commit .env.
# Values below are DEVELOPMENT-ONLY placeholders for the local Docker Compose stack
# (infra/compose.yaml, bound to 127.0.0.1). Never reuse them anywhere else.

# Read through packages/config, the only module that touches process.env. Api requires
# NODE_ENV, API_PORT, API_HOST, WEB_ORIGIN and DATABASE_URL (TRUSTED_PROXY_HOPS in production), and worker
# NODE_ENV and REDIS_URL; DATABASE_MIGRATION_URL and S3_* are validated by packages/config for the M1
# adapters but required by no app yet. A missing or malformed required
# value stops the app at startup, naming the variable (never its value). Web reads no variables.

NODE_ENV=development
API_PORT=3001
# Explicit bind address; never all interfaces by default.
API_HOST=127.0.0.1
# The only origin allowed to make unsafe requests (bare origin; https in production).
WEB_ORIGIN=http://127.0.0.1:3000
# Proxies between the internet and the API that append the client address (Express trust proxy).
# 0 when the API is reached directly; mandatory in production, where a wrong count makes the
# client address spoofable.
TRUSTED_PROXY_HOPS=0

# Local infrastructure (Docker Compose).
# POSTGRES_*, POSTGRES_APP_PASSWORD and REDIS_PASSWORD are read by Compose only; keep them consistent
# with the URLs. POSTGRES_USER owns the schema and is used only by `pnpm run db:migrate`
# (DATABASE_MIGRATION_URL). Apps connect as contextvault_app (DATABASE_URL), which cannot own
# tables, bypass row-level security, or run DDL. Roles exist only on a fresh volume: after pulling
# this change on an existing one, run `pnpm run infra:reset` (deletes local data), then `infra:up`
# and `db:migrate`.
POSTGRES_USER=contextvault
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_APP_PASSWORD=dev-only-app-password
POSTGRES_DB=contextvault
DATABASE_URL=postgres://contextvault_app:dev-only-app-password@127.0.0.1:5432/contextvault
DATABASE_MIGRATION_URL=postgres://contextvault:dev-only-postgres-password@127.0.0.1:5432/contextvault
REDIS_PASSWORD=dev-only-redis-password
REDIS_URL=redis://:dev-only-redis-password@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
# S3_REGION is optional (defaults to us-east-1); every other variable below is required.
S3_REGION=us-east-1
S3_BUCKET=contextvault-dev
S3_ACCESS_KEY_ID=dev-only-access-key
S3_SECRET_ACCESS_KEY=dev-only-secret-key-0123456789
