        "memberships_select_own": {
          "name": "memberships_select_own",
          "as": "PERMISSIVE",
          "for": "SELECT",
          "to": ["contextvault_app"],
          "using": "\"memberships\".\"user_id\" = nullif(current_setting('app.user_id', true), '')::uuid\n        and (nullif(current_setting('app.workspace_id', true), '')::uuid is null or \"memberships\".\"workspace_id\" = nullif(current_setting('app.workspace_id', true), '')::uuid)"
        },
        "memberships_insert": {
          "name": "memberships_insert",
          "as": "PERMISSIVE",
          "for": "INSERT",
          "to": ["contextvault_app"],
          "withCheck": "(nullif(current_setting('app.workspace_id', true), '')::uuid is null or \"memberships\".\"workspace_id\" = nullif(current_setting('app.workspace_id', true), '')::uuid)\n        and (\n          (\"memberships\".\"user_id\" = nullif(current_setting('app.user_id', true), '')::uuid and \"memberships\".\"role\" = 'owner' and exists (\n            select 1 from \"workspaces\" w\n            where w.id = \"memberships\".\"workspace_id\"\n              and w.created_by = nullif(current_setting('app.user_id', true), '')::uuid and w.created_at = now()))\n          or exists (\n            select 1 from \"memberships\" actor\n            where actor.workspace_id = \"memberships\".\"workspace_id\" and actor.user_id = nullif(current_setting('app.user_id', true), '')::uuid\n              and (actor.role = 'owner' or (actor.role = 'admin' and \"memberships\".\"role\" <> 'owner')))\n        )"
        }
      },
      "checkConstraints": {
        "memberships_role": {
          "name": "memberships_role",
          "value": "\"memberships\".\"role\" in ('owner', 'admin', 'member')"
        }
      },
