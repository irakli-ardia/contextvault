#!/bin/sh
node scripts/git/conventions.mjs current || exit 1
node scripts/checks/docs-check.mjs || exit 1
node scripts/checks/tracked-files.mjs || exit 1

# Integration tests need the local stack. Read-only check: this hook never starts or stops containers.
if [ ! -f .env ]; then
  echo "pre-push: .env is missing. Run: cp .env.example .env && pnpm run infra:up" >&2
  exit 1
fi
if [ ! -f .env.test ]; then
  echo "pre-push: .env.test is missing. See docs/local-setup.md (Environment)." >&2
  exit 1
fi
healthy=$(pnpm --silent run infra:ps --format '{{.Health}}' 2>/dev/null | grep -c '^healthy$')
if [ "$healthy" -ne 3 ]; then
  echo "pre-push: local infrastructure is not healthy ($healthy of 3 services). Run: pnpm run infra:up" >&2
  exit 1
fi

# Migrations are idempotent; integration tests need them applied.
pnpm run db:migrate || exit 1

# Every check is mandatory: a missing script is a failure, not a skip.
for script in format:check lint arch dead-code db:check typecheck test test:integration build test:e2e; do
  pnpm run "$script" || exit 1
done
