{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/next-env.d.ts",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!**/*.svg",
      "!.claude",
      "!.agents"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": { "noUselessTernary": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "performance": { "noReExportAll": "error" },
      "style": {
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noProcessEnv": "error",
        "useImportType": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 250 } },
        "useFilenamingConvention": {
          "level": "error",
          "options": { "strictCase": true, "requireAscii": true, "filenameCases": ["kebab-case"] }
        }
      },
      "suspicious": { "noExplicitAny": "error", "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/config/src/env.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      "includes": ["packages/domain/**", "packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "@nestjs/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "bullmq",
                      "ioredis"
                    ],
                    "message": "Domain and contract packages import no framework, ORM, or queue client: declare a port and adapt it outside."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
