{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/next-env.d.ts",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!**/*.svg",
      "!.claude",
      "!.agents"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": { "noUselessTernary": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "performance": { "noReExportAll": "error" },
      "style": {
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noProcessEnv": "error",
        "useImportType": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 250 } },
        "useFilenamingConvention": {
          "level": "error",
          "options": { "strictCase": true, "requireAscii": true, "filenameCases": ["kebab-case"] }
        }
      },
      "suspicious": { "noExplicitAny": "error", "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/config/src/env.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@contextvault/config": {
                    "importNames": ["loadMigrationEnv", "parseMigrationEnv"],
                    "message": "The owner-role migration URL is read only by the db:migrate command."
                  }
                },
                "patterns": [
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**", "pg", "pg/**"],
                    "message": "Only packages/db imports the ORM and the Postgres driver."
                  },
                  {
                    "group": ["@contextvault/db/*", "**/packages/db/**"],
                    "message": "Import @contextvault/db only through its entry point."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**/*.test.ts", "apps/**/test-support.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@contextvault/config": {
                    "importNames": ["loadMigrationEnv", "parseMigrationEnv"],
                    "message": "The owner-role migration URL is read only by the db:migrate command."
                  }
                },
                "patterns": [
                  {
                    "group": ["drizzle-orm", "drizzle-orm/**", "pg", "pg/**"],
                    "message": "Only packages/db imports the ORM and the Postgres driver."
                  },
                  {
                    "group": ["**/packages/db/**"],
                    "message": "Import @contextvault/db through its entry points."
                  },
                  {
                    "group": ["@contextvault/db/*", "!@contextvault/db/testing"],
                    "message": "Tests may use only the @contextvault/db/testing entry."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@contextvault/auth": "Persistence code never depends on the password hasher; only the operator entry point (user-create.ts) injects it."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/src/user-create.ts",
        "packages/db/src/e2e-accounts.ts",
        "packages/db/src/provisioning/test-harness.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["packages/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "next",
                      "next/**",
                      "@nestjs/**",
                      "express",
                      "node:http",
                      "node:https",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**"
                    ],
                    "message": "packages/auth knows neither HTTP nor SQL: it adapts domain ports to Node crypto."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/**", "packages/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "@nestjs/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg",
                      "pg/**",
                      "bullmq",
                      "ioredis"
                    ],
                    "message": "Domain and contract packages import no framework, ORM, or queue client: declare a port and adapt it outside."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
