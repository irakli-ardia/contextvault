{
  "name": "contextvault",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint": "biome check . && oxlint --type-aware",
    "lint:fix": "biome check --write . && oxlint --type-aware --fix",
    "structure": "node scripts/checks/structure-check.mjs",
    "arch": "fallow architecture --config .fallowrc.json",
    "dead-code": "fallow dead-code --config .fallowrc.json",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --project unit",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @contextvault/web --filter @contextvault/api --filter @contextvault/worker run build",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "pnpm --filter @contextvault/db run bundle && playwright test",
    "test:e2e:ci": "pnpm --filter @contextvault/db run bundle && node --env-file=.env --env-file=.env.test scripts/test-stack/with-ci-stack.mjs run node node_modules/@playwright/test/cli.js test",
    "infra:mark:ci": "node --env-file=.env --env-file=.env.test scripts/test-stack/with-ci-stack.mjs mark",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up --wait --wait-timeout 180 && node scripts/infra/infra-bucket.mjs",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "infra:ps": "docker compose --env-file .env -f infra/compose.yaml ps",
    "infra:logs": "docker compose --env-file .env -f infra/compose.yaml logs --tail 100",
    "infra:reset": "docker compose --env-file .env -f infra/compose.yaml down --volumes",
    "infra:roles": "node scripts/infra/infra-roles.mjs",
    "infra:roles:rollback": "node scripts/infra/infra-roles.mjs rollback",
    "infra:smoke": "node scripts/infra/infra-smoke.mjs",
    "db:generate": "pnpm --filter @contextvault/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @contextvault/db run migrate",
    "user:create": "pnpm --filter @contextvault/db run bundle && node --env-file-if-exists=.env packages/db/dist/user-create.mjs",
    "db:check": "node scripts/checks/db-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "fallow": "3.40.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
