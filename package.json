{
  "name": "contextvault",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint": "biome check . && oxlint --type-aware",
    "lint:fix": "biome check --write . && oxlint --type-aware --fix",
    "arch": "fallow architecture --config .fallowrc.json",
    "dead-code": "fallow dead-code --config .fallowrc.json",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --project unit",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @contextvault/web --filter @contextvault/api --filter @contextvault/worker run build",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "playwright test",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up --wait --wait-timeout 180",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "infra:ps": "docker compose --env-file .env -f infra/compose.yaml ps",
    "infra:logs": "docker compose --env-file .env -f infra/compose.yaml logs --tail 100",
    "infra:reset": "docker compose --env-file .env -f infra/compose.yaml down --volumes",
    "infra:smoke": "node scripts/checks/infra-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "fallow": "3.36.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
